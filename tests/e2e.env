# Environment for tests/e2e_platform.py (local MongoDB replica set on 27017).
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB_NAME=dm_e2e
DM_API_KEYS=dmart-ready-ios:test-key
DM_ADMIN_KEY=test-admin
PORT=8090
GRPC_PORT=50061
DM_TOKEN_SECRET=e2e-secret-0123456789abcdef
DM_APPCHECK_DEBUG_TOKENS=DEBUG-TOKEN-1234567890
DM_FUNCTIONS_SECRET=fn-secret
DM_AUTH_ACTION_URL=https://example.com/__/auth/action
DM_WEBPUSH_SUBJECT=mailto:ops@dmart.example
DM_WEBPUSH_ALLOW_HTTP_ENDPOINTS=true
# DM_WEBPUSH_VAPID_PRIVATE_KEY: generate with POST /admin/messaging/webpush/keys, then restart
DM_AUTH_AUTHORIZED_DOMAINS=localhost,example.com,dmart.example
