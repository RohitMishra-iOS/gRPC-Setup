# ── Local development ─────────────────────────────────────────────────────────

# gRPC server — internal port (never exposed to the internet)
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# gRPC-Web proxy — public-facing port
# Locally: set this manually
# On Render: leave unset — Render injects PORT automatically
PROXY_PORT=8080

# CORS — allowed origins for browser clients
# Development : * (allow all)
# Production  : https://yourapp.onrender.com,https://yourapp.com
ALLOWED_ORIGINS=*

# MongoDB Atlas connection string — incoming event batches are persisted here
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=grpc_status

# ── DM SDK 2.0 ────────────────────────────────────────────────────────────────
# API keys accepted on dm.sdk.v1 services and /v1/symbols (sent by the iOS SDK as x-api-key).
# Comma-separated; "app_id:key" limits a key to one app. Empty = no auth (local dev only).
DM_API_KEYS=dmart-ready-ios:change-me-app-key
# Admin API key (/admin/...). Empty = admin API disabled.
DM_ADMIN_KEY=change-me-admin-key
# Retention (days) for crash_reports / perf_records / push_messages. 0 = keep forever.
DM_RETENTION_DAYS=90
# Retention for analytics batches (event_data). 0 = keep forever (1.x behaviour).
DM_ANALYTICS_RETENTION_DAYS=0
# Remote Config throttling per installation per hour.
DM_RC_FETCHES_PER_HOUR=30
DM_RC_REALTIME_CHECKS_PER_HOUR=120
# Crash alerts (Slack-compatible webhook) and the per-hour velocity threshold.
DM_ALERT_WEBHOOK_URL=
DM_VELOCITY_ALERT_THRESHOLD=25
# Max dSYM upload size (MB).
DM_SYMBOLS_MAX_MB=512

# APNs (push sending). Apple Developer → Certificates, IDs & Profiles → Keys → + (APNs).
# Either paste the .p8 contents (\n for newlines) or point at the file.
APNS_KEY_P8=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# Fallback apns-topic when a device has no bundle id recorded.
APNS_TOPIC=

# ── Render platform notes ─────────────────────────────────────────────────────
# Render injects the PORT environment variable automatically.
# The server reads: PORT, then PROXY_PORT, then defaults to 8080
# So on Render, just leave PORT unset — Render handles it.
#
# Set these in the Render dashboard under Environment → Add Environment Variable:
#   GRPC_PORT       = 50051
#   GRPC_HOST       = 0.0.0.0
#   ALLOWED_ORIGINS = https://yourfrontend.onrender.com
#   MONGODB_URI     = mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
#   MONGODB_DB_NAME = grpc_status
#   DM_API_KEYS, DM_ADMIN_KEY, APNS_KEY_P8, APNS_KEY_ID, APNS_TEAM_ID (secrets — mark as secret)
