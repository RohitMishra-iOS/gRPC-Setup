# ── Local development ─────────────────────────────────────────────────────────

# gRPC server — internal port (never exposed to the internet)
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# gRPC-Web proxy — public-facing port
# Locally: set this manually
# On Render: leave unset — Render injects PORT automatically
PROXY_PORT=8080

# CORS — allowed origins for browser clients
# Development : * (allow all)
# Production  : https://yourapp.onrender.com,https://yourapp.com
ALLOWED_ORIGINS=*

# MongoDB Atlas connection string — incoming event batches are persisted here
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=grpc_status

# ── DM SDK 2.0 ────────────────────────────────────────────────────────────────
# API keys accepted on dm.sdk.v1 services and /v1/symbols (sent by the iOS SDK as x-api-key).
# Comma-separated; "app_id:key" limits a key to one app. Empty = no auth (local dev only).
DM_API_KEYS=dmart-ready:change-me-app-key
# Admin API key (/admin/...). Empty = admin API disabled.
DM_ADMIN_KEY=change-me-admin-key
# Retention (days) for crash_reports / perf_records / push_messages. 0 = keep forever.
DM_RETENTION_DAYS=90
# Retention for analytics batches (event_data). 0 = keep forever (1.x behaviour).
DM_ANALYTICS_RETENTION_DAYS=0
# Remote Config throttling per installation per hour.
DM_RC_FETCHES_PER_HOUR=30
DM_RC_REALTIME_CHECKS_PER_HOUR=120
# Long polling: hold real-time checks open until a publish (seconds, < SDK fetchTimeout 60)
DM_RC_REALTIME_HOLD_SECONDS=45

# ── Platform services (Installations, App Check, Auth, Storage, Functions, Database) ──
# Signs every token the server issues. REQUIRED in production (openssl rand -hex 32); without it
# a random secret is used and everyone is signed out on every restart.
DM_TOKEN_SECRET=
# iss/aud of ID tokens
DM_PROJECT_ID=dm-project
# Reject requests without App Check for: auth, storage, functions, database, rpc (or "all")
DM_APPCHECK_ENFORCE=
DM_APPCHECK_TTL_SECONDS=3600
# Debug-provider tokens (simulators / CI); more can be added in the console
DM_APPCHECK_DEBUG_TOKENS=
# App Attest: app_id=<TEAMID>.<bundle id>, and Apple's root CA (Apple_App_Attestation_Root_CA.pem)
DM_APP_ATTEST_APPS=dmart-ready-ios=ABCDE12345.com.dmart.ready
DM_APP_ATTEST_ROOT_CA=
DM_APP_ATTEST_DEVELOPMENT=false
# DeviceCheck key (defaults to the APNs key if it has DeviceCheck enabled)
DM_DEVICECHECK_KEY_P8=
DM_DEVICECHECK_KEY_ID=
DM_DEVICECHECK_TEAM_ID=
DM_DEVICECHECK_DEVELOPMENT=false
# Play Integrity: service-account JSON (inline) with the Play Integrity API enabled
DM_PLAY_INTEGRITY_SERVICE_ACCOUNT=
# Auth
DM_AUTH_ALLOW_ANONYMOUS=true
DM_AUTH_ALLOW_SIGNUP=true
DM_AUTH_GOOGLE_CLIENT_IDS=
DM_AUTH_APPLE_AUDIENCES=com.dmart.ready
# POST {type, email, link} here to send password-reset / verification / sign-in emails
DM_AUTH_EMAIL_WEBHOOK=
DM_AUTH_ACTION_URL=https://your-site.example.com/auth/action
# Hosts allowed as continueUrl in email links (default: localhost + the DM_AUTH_ACTION_URL host).
# DM_AUTH_AUTHORIZED_DOMAINS=dmart.in,your-site.example.com
# Password policy: minimum length (6-128) and required character classes.
# DM_AUTH_PASSWORD_MIN_LENGTH=8
# DM_AUTH_PASSWORD_REQUIRE=upper,lower,digit,symbol
# Callable functions: HMAC secret sent as X-DM-Signature (can also be set per function)
DM_FUNCTIONS_SECRET=
DM_STORAGE_MAX_MB=100
# Android push: FCM HTTP v1 service account JSON (from the Firebase project of your google-services.json)
DM_FCM_SERVICE_ACCOUNT=
# Browser push: VAPID key pair — generate with POST /admin/messaging/webpush/keys
DM_WEBPUSH_VAPID_PRIVATE_KEY=
DM_WEBPUSH_SUBJECT=mailto:you@example.com
# Feed database listeners from a MongoDB change stream (needed when running >1 instance)
DM_DB_CHANGE_STREAMS=false
# Crash alerts (Slack-compatible webhook) and the per-hour velocity threshold.
DM_ALERT_WEBHOOK_URL=
DM_VELOCITY_ALERT_THRESHOLD=25
# Max dSYM upload size (MB).
DM_SYMBOLS_MAX_MB=512

# APNs (push sending). Apple Developer → Certificates, IDs & Profiles → Keys → + (APNs).
# Either paste the .p8 contents (\n for newlines) or point at the file.
APNS_KEY_P8=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# Fallback apns-topic when a device has no bundle id recorded.
APNS_TOPIC=

# ── Render platform notes ─────────────────────────────────────────────────────
# Render injects the PORT environment variable automatically.
# The server reads: PORT, then PROXY_PORT, then defaults to 8080
# So on Render, just leave PORT unset — Render handles it.
#
# Set these in the Render dashboard under Environment → Add Environment Variable:
#   GRPC_PORT       = 50051
#   GRPC_HOST       = 0.0.0.0
#   ALLOWED_ORIGINS = https://yourfrontend.onrender.com
#   MONGODB_URI     = mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
#   MONGODB_DB_NAME = grpc_status
#   DM_API_KEYS, DM_ADMIN_KEY, APNS_KEY_P8, APNS_KEY_ID, APNS_TEAM_ID (secrets — mark as secret)

# With DM_API_KEYS set, analytics batches (/events, CheckStatus) must carry a valid API key, like
# every other service. Set to false only while old iOS builds that send no key are still in use.
# DM_EVENTS_REQUIRE_API_KEY=false
