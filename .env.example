# ── Local development ─────────────────────────────────────────────────────────

# gRPC server — internal port (never exposed to the internet)
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# gRPC-Web proxy — public-facing port
# Locally: set this manually
# On Render: leave unset — Render injects PORT automatically
PROXY_PORT=8080

# CORS — allowed origins for browser clients
# Development : * (allow all)
# Production  : https://yourapp.onrender.com,https://yourapp.com
ALLOWED_ORIGINS=*

# MongoDB Atlas connection string — incoming event batches are persisted here
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=grpc_status

# ── Render platform notes ─────────────────────────────────────────────────────
# Render injects the PORT environment variable automatically.
# server.js reads: process.env.PORT || process.env.PROXY_PORT || 8080
# So on Render, just leave PORT unset — Render handles it.
#
# Set these in the Render dashboard under Environment → Add Environment Variable:
#   GRPC_PORT       = 50051
#   GRPC_HOST       = 0.0.0.0
#   NODE_ENV        = production
#   ALLOWED_ORIGINS = https://yourfrontend.onrender.com
#   MONGODB_URI     = mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
#   MONGODB_DB_NAME = grpc_status
