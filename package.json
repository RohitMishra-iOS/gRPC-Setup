{
  "name": "grpc-status-server",
  "version": "1.0.0",
  "description": "gRPC Status Server - compatible with React, React Native, Android, iOS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "proxy": "node grpc-web-proxy.js",
    "start:all": "concurrently \"node server.js\" \"node grpc-web-proxy.js\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
